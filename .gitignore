# macOS
.DS_Store
**/.DS_Store

# Python cache
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Build output — regenerated by build.py / skills/quote-document/scripts/rebuild_plugin.py
*.plugin
build/

# Per-developer build settings; .env.example documents them.
.env

# Working files produced during a live quoting session. These carry real client
# names, addresses and pricing — they belong in the capture folder, never here.
# Anchored to the repo root with a leading slash: a live session writes them into
# the working directory, whereas the eval fixtures use these same filenames under
# evals/fixtures/ and MUST stay tracked — they are the regression suite.
/quote.json
/raw_quote.json
/scenarios.json
/request.md
/handoff/
/draft.json
/draft.txt
*.route-map.png
*.print.html
*.capture.json
*.feedback.json

# Source covers are not shipped; the pre-rendered JPEGs in
# skills/quote-document/assets/covers/ are what the plugin uses.
covers-src/
